# PASO 6 · Conectar las 3 listas

**Inicio → Nuevo origen → Más → SharePoint → Lista de SharePoint Online** → pega la dirección del sitio → **Implementación 2.0** → si pide credenciales, **Cuenta profesional o educativa** → marca `REGISTROS_AGUA`, `CONSUMOAGUAINVERNADEROS`, `PLANTAS` → **Transformar datos**.

Van a llegar tres consultas. A cada una le entras al **Editor avanzado** y le pegas el código de abajo. **Ninguna columna tuya se renombra**: solo cambia el tipo de dato y se agregan columnas nuevas al final.

## 6.1 `REGISTROS_AGUA`

```m
let
    Origen = SharePoint.Tables(pSitio, [Implementation="2.0", ViewMode="All"]),
    Lista  = Origen{[Title="REGISTROS_AGUA"]}[Items],
    Cols   = Table.SelectColumns(Lista, {"ID_EQUIPO","FECHA_LECTURA","LECTURA_ANTERIOR","LECTURA_ACTUAL",
             "CONSUMO_M3","TIPOAGUA","AREA","METODO_REGISTRO","DESCRIPCION","DETALLE","CATEGORIA",
             "DISTRIBUCION","SISTEMA"}),

    Limpio = Table.TransformColumns(Cols, {
                {"ID_EQUIPO",        each Text.Upper(Text.Trim(Text.From(_))), type text},
                {"FECHA_LECTURA",    each fnFechaSP(_), type date},
                {"LECTURA_ANTERIOR", each fnTextoANumero(_), type number},
                {"LECTURA_ACTUAL",   each fnTextoANumero(_), type number},
                {"CONSUMO_M3",       each fnTextoANumero(_), type number}}),

    ConFecha = Table.SelectRows(Limpio, each [FECHA_LECTURA] <> null),

    // UNA lectura por contador y dia = el dato mas alto
    PorDia = Table.Group(ConFecha, {"ID_EQUIPO","FECHA_LECTURA"}, {
                {"LECTURA_ACTUAL",   each List.Max([LECTURA_ACTUAL]), type number},
                {"LECTURA_ANTERIOR", each List.Min([LECTURA_ANTERIOR]), type number},
                {"CONSUMO_M3",       each List.Sum([CONSUMO_M3]), type number},
                {"Lecturas_Del_Dia", each Table.RowCount(_), Int64.Type},
                {"TIPOAGUA",         each List.First([TIPOAGUA]), type text},
                {"AREA",             each List.First([AREA]), type text},
                {"METODO_REGISTRO",  each List.First([METODO_REGISTRO]), type text},
                {"DESCRIPCION",      each List.First([DESCRIPCION]), type text},
                {"DETALLE",          each List.First([DETALLE]), type text},
                {"CATEGORIA",        each List.First([CATEGORIA]), type text},
                {"DISTRIBUCION",     each List.First([DISTRIBUCION]), type text},
                {"SISTEMA",          each List.First([SISTEMA]), type text}}),

    Positivas = Table.SelectRows(PorDia, each [LECTURA_ACTUAL] <> null and [LECTURA_ACTUAL] > 0),

    // consumo contra la ULTIMA LECTURA BUENA
    PorEquipo = Table.Group(Positivas, {"ID_EQUIPO"}, {{"t", each
        let
            t0    = Table.Sort(_, {{"FECHA_LECTURA", Order.Ascending}}),
            filas = Table.ToRecords(t0),
            proc  = List.Accumulate(filas, [ult = null, acc = {}], (e, f) =>
                let
                    dif  = if e[ult] = null then null else f[LECTURA_ACTUAL] - e[ult][LECTURA_ACTUAL],
                    malo = dif <> null and (dif < 0 or dif > pLimiteConsumoM3),
                    reg  = f & [
                        Lectura_Previa  = if e[ult] = null then null else e[ult][LECTURA_ACTUAL],
                        Fecha_Previa    = if e[ult] = null then null else e[ult][FECHA_LECTURA],
                        M3_Final        = if malo or dif = null then null else dif,
                        Motivo_Anomalia = if malo then (if dif < 0 then "Retroceso de lectura"
                                                        else "Consumo fuera de rango") else null]
                in
                    [ ult = if malo then e[ult] else f, acc = e[acc] & {reg} ]),
            salida = Table.FromRecords(proc[acc])
        in
            salida, type table}}),

    Plano  = Table.ExpandTableColumn(PorEquipo, "t",
                {"FECHA_LECTURA","LECTURA_ACTUAL","LECTURA_ANTERIOR","CONSUMO_M3","Lecturas_Del_Dia",
                 "TIPOAGUA","AREA","METODO_REGISTRO","DESCRIPCION","DETALLE","CATEGORIA","DISTRIBUCION",
                 "SISTEMA","Lectura_Previa","Fecha_Previa","M3_Final","Motivo_Anomalia"}),

    Dias   = Table.AddColumn(Plano, "Dias_Periodo", each
                if [Fecha_Previa] = null then null
                else List.Max({Duration.Days([FECHA_LECTURA] - [Fecha_Previa]), 1}), Int64.Type),
    Valido = Table.AddColumn(Dias, "Es_Valido", each [Motivo_Anomalia] = null, type logical),
    Tipos  = Table.TransformColumnTypes(Valido, {{"FECHA_LECTURA", type date},{"Fecha_Previa", type date},
                {"M3_Final", type number},{"Lectura_Previa", type number},{"Motivo_Anomalia", type text}})
in
    Tipos
```

