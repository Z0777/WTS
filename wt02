## 6. Código M corregido

Solo cambian tres consultas. El resto de la guía sigue igual.

### 6.1 Parámetro nuevo

**Inicio → Administrar parámetros → Nuevo**: `pMetodoNaves`, tipo Texto, valor `Promedio`.

### 6.2 `REGISTROS_AGUA`

```m
let
    Origen = SharePoint.Tables(pSitio, [Implementation="2.0", ViewMode="All"]),
    Lista  = Origen{[Title="REGISTROS_AGUA"]}[Items],
    Cols   = Table.SelectColumns(Lista, {"ID_EQUIPO","FECHA_LECTURA","LECTURA_ANTERIOR","LECTURA_ACTUAL",
             "CONSUMO_M3","TIPOAGUA","AREA","METODO_REGISTRO","DESCRIPCION","DETALLE","CATEGORIA","DISTRIBUCION","SISTEMA"}),

    // BOMB01 es una bomba, no contabiliza agua
    SinBomba = Table.SelectRows(Cols, each Text.Upper(Text.Trim(Text.From([ID_EQUIPO]))) <> "BOMB01"),

    // limpieza sobre la misma columna, sin renombrar nada
    Limpio = Table.TransformColumns(SinBomba, {
                {"ID_EQUIPO",        each Text.Upper(Text.Trim(Text.From(_))), type text},
                {"FECHA_LECTURA",    each fnFechaSP(_), type date},
                {"LECTURA_ANTERIOR", each fnTextoANumero(_), type number},
                {"LECTURA_ACTUAL",   each fnTextoANumero(_), type number},
                {"CONSUMO_M3",       each fnTextoANumero(_), type number}}),

    // ---- UNA lectura por contador y dia: EL DATO MAS ALTO ----
    PorDia = Table.Group(Limpio, {"ID_EQUIPO","FECHA_LECTURA"}, {
                {"LECTURA_ACTUAL",   each List.Max([LECTURA_ACTUAL]), type number},
                {"LECTURA_ANTERIOR", each List.Min([LECTURA_ANTERIOR]), type number},
                {"CONSUMO_M3",       each List.Sum([CONSUMO_M3]), type number},
                {"Lecturas_Del_Dia", each Table.RowCount(_), Int64.Type},
                {"_d", each Table.FirstN(Table.SelectColumns(_,
                    {"TIPOAGUA","AREA","METODO_REGISTRO","DESCRIPCION","DETALLE","CATEGORIA","DISTRIBUCION","SISTEMA"}),1), type table}}),
    Desc   = Table.ExpandTableColumn(PorDia, "_d",
                {"TIPOAGUA","AREA","METODO_REGISTRO","DESCRIPCION","DETALLE","CATEGORIA","DISTRIBUCION","SISTEMA"}),

    // se descartan las lecturas vacias o en cero
    Positivas = Table.SelectRows(Desc, each [LECTURA_ACTUAL] <> null and [LECTURA_ACTUAL] > 0),

    // ---- consumo contra la ULTIMA LECTURA BUENA ----
    // Si una lectura retrocede o salta mas de pLimiteConsumoM3, se marca y NO se toma
    // como referencia: la siguiente se calcula contra la ultima buena.
    PorEquipo = Table.Group(Positivas, {"ID_EQUIPO"}, {{"t", each
        let
            t0    = Table.Sort(_, {{"FECHA_LECTURA", Order.Ascending}}),
            filas = Table.ToRecords(t0),
            proc  = List.Accumulate(filas, [ult = null, acc = {}], (e, f) =>
                let
                    dif  = if e[ult] = null then null else f[LECTURA_ACTUAL] - e[ult][LECTURA_ACTUAL],
                    malo = dif <> null and (dif < 0 or dif > pLimiteConsumoM3),
                    reg  = f & [
                        Lectura_Previa  = if e[ult] = null then null else e[ult][LECTURA_ACTUAL],
                        Fecha_Previa    = if e[ult] = null then null else e[ult][FECHA_LECTURA],
                        M3_Final        = if malo or dif = null then null else dif,
                        Motivo_Anomalia = if malo then (if dif < 0 then "Retroceso de lectura"
                                                        else "Consumo fuera de rango") else null]
                in
                    [ ult = if malo then e[ult] else f, acc = e[acc] & {reg} ])
        in
            Table.FromRecords(proc[acc]), type table}}),
    Plano  = Table.ExpandTableColumn(PorEquipo, "t",
                List.Difference(Table.ColumnNames(PorEquipo{0}[t]), {"ID_EQUIPO"})),

    Dias   = Table.AddColumn(Plano, "Dias_Periodo", each
                if [Fecha_Previa] = null then null
                else List.Max({Duration.Days([FECHA_LECTURA] - [Fecha_Previa]), 1}), Int64.Type),
    Valido = Table.AddColumn(Dias, "Es_Valido", each [Motivo_Anomalia] = null, type logical)
in
    Valido
```

### 6.3 `ConsumoGoteroDia`

```m
let
    Origen  = Table.SelectRows(CONSUMOAGUAINVERNADEROS, each [ML_Valido] = true),

    // PASO 1 — misma nave, mismo dia: EL DATO MAS ALTO
    PorNave = Table.Group(Origen, {"Invernadero","Nave","Fecha de colecta de muestra"},
                {{"ML",  each List.Max([#"Volumen de gotero"]), type number},
                 {"DRE", each List.Max([#"Volumen drenaje"]), type number},
                 {"Repeticiones", each Table.RowCount(_), Int64.Type}}),

    // PASO 2 — entre naves: promedio (o maximo, segun pMetodoNaves)
    PorInv  = Table.Group(PorNave, {"Invernadero","Fecha de colecta de muestra"},
                {{"ML_Planta_Dia",  each if pMetodoNaves = "Maximo" then List.Max([ML]) else List.Average([ML]), type number},
                 {"ML_Drenaje_Dia", each if pMetodoNaves = "Maximo" then List.Max([DRE]) else List.Average([DRE]), type number},
                 {"Naves_Medidas",  each Table.RowCount(_), Int64.Type}}),

    Marca   = Table.AddColumn(PorInv, "Fecha_Medicion", each [#"Fecha de colecta de muestra"], type date)
in
    Table.RenameColumns(Marca, {{"Fecha de colecta de muestra","Fecha"}})
```

### 6.4 `fRiegoDia` — con interpolación

Los pasos 1, 2 y 3 son los mismos de la guía (expandir cada set a días, calcular DDT y etapa, y unir con `ConsumoGoteroDia`). Cambia del paso 4 en adelante:

```m
    // 4) preparar las columnas auxiliares de interpolacion
    Aux    = Table.AddColumn(
                Table.AddColumn(ConML, "_MLAnt", each [ML_Planta_Dia], type number),
                "_FecAnt", each if [ML_Planta_Dia] = null then null else [Fecha], type date),
    Aux2   = Table.AddColumn(
                Table.AddColumn(Aux, "_MLSig", each [ML_Planta_Dia], type number),
                "_FecSig", each if [ML_Planta_Dia] = null then null else [Fecha], type date),

    // 5) hacia atras y hacia adelante, DENTRO de cada invernadero
    Orden  = Table.Sort(Aux2, {{"Greenhouse", Order.Ascending},{"Fecha", Order.Ascending}}),
    Grupo  = Table.Group(Orden, {"Greenhouse"}, {{"t", each
                Table.FillUp(
                    Table.FillDown(Table.Sort(_, {{"Fecha", Order.Ascending}}), {"_MLAnt","_FecAnt"}),
                    {"_MLSig","_FecSig"}), type table}}),
    Plano  = Table.ExpandTableColumn(Grupo, "t", List.Difference(Table.ColumnNames(Grupo{0}[t]), {"Greenhouse"})),

    // 6) interpolacion lineal
    MLUso  = Table.AddColumn(Plano, "ML_Usado", each
        if [ML_Planta_Dia] <> null then [ML_Planta_Dia]
        else if [_MLAnt] <> null and [_MLSig] <> null and [_FecSig] <> [_FecAnt] then
            [_MLAnt] + ([_MLSig] - [_MLAnt])
                     * Duration.Days([Fecha] - [_FecAnt]) / Duration.Days([_FecSig] - [_FecAnt])
        else if [_MLAnt] <> null then [_MLAnt]
        else if [_MLSig] <> null then [_MLSig]
        else null, type number),

    Estado = Table.AddColumn(MLUso, "Estado_Dato", each
        if [ML_Planta_Dia] <> null then "Medido"
        else if [_MLAnt] <> null and [_MLSig] <> null then "Interpolado"
        else if [ML_Usado] <> null then "Extendido"
        else "Sin medicion en el ciclo", type text),

    // 7) litros por set
    Litros = Table.AddColumn(Estado, "Litros_Dia", each
                if [ML_Usado] = null then null else [ML_Usado] * [PlantsTransplanted] / 1000, type number),
    M3     = Table.AddColumn(Litros, "M3_Dia", each
                if [Litros_Dia] = null then null else [Litros_Dia] / 1000, type number),
    Quita  = Table.RemoveColumns(M3, {"_MLAnt","_FecAnt","_MLSig","_FecSig"})
in
    Quita
```

> `pDiasMaxRelleno` ya no se usa. Puedes borrar el parámetro o dejarlo; no afecta.

