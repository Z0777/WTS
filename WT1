                in if r <> null then r else e, type date),

    ConCic = Table.ExpandTableColumn(
                Table.NestedJoin(FFin0, {"Crop"}, dCultivo, {"Crop"}, "c", JoinKind.LeftOuter),
                "c", {"DiasEnInvernadero","DDT_IniPol","DDT_FinPol","DDT_IniCos","DDT_FinCos"}),

    FFin   = Table.AddColumn(ConCic, "Fecha_Fin", each
                if [_FinReg] <> null then [_FinReg]
                else if [Fecha_Inicio] <> null and [DiasEnInvernadero] <> null
                     then Date.AddDays([Fecha_Inicio], [DiasEnInvernadero]) else null, type date),

    Orig   = Table.AddColumn(FFin, "Origen_Fechas", each
                (if fnFechaSP([#"Real  transplanting date"]) <> null then "Trasplante real" else "Trasplante estimado")
                & " / " &
                (if fnFechaSP([#"Real last harvest date"]) <> null then "Cosecha real" else "Cosecha estimada"), type text),

    Estado = Table.AddColumn(Orig, "Estado_Set", each
                if [Fecha_Inicio] = null then "Sin fecha"
                else if [Fecha_Inicio] > Date.From(DateTime.LocalNow()) then "Programado"
                else if [Fecha_Fin] <> null and [Fecha_Fin] < Date.From(DateTime.LocalNow()) then "Finalizado"
                else "Activo", type text),

    Final  = Table.SelectRows(Table.RemoveColumns(Estado, {"_FinReg"}),
                each [Fecha_Inicio] <> null and [Fecha_Fin] <> null
                     and [PlantsTransplanted] <> null and [PlantsTransplanted] > 0)
in
    Final
```

> **Los sets ya terminados no se filtran.** Un ciclo que cerró en abril sigue en el modelo y sigue aportando su consumo a abril. Es exactamente la evidencia histórica que necesitas.

### Paso 6 · Las 3 consultas derivadas

Estas se crean con **clic derecho sobre una consulta existente → Referencia**, o simplemente como consulta en blanco con este código.

**`fAguaDiaria`** — reparte el consumo de cada lectura entre los días del periodo
```m
let
    Origen  = Table.SelectRows(REGISTROS_AGUA, each [Es_Valido] = true and [FECHA_LECTURA] <> null),
    ConEq   = Table.ExpandTableColumn(
                Table.NestedJoin(Origen, {"ID_EQUIPO"}, dEquipo, {"ID_EQUIPO"}, "eq", JoinKind.Inner),
                "eq", {"INCLUIR_EN_BALANCE"}),
    Incluir = Table.SelectRows(ConEq, each [INCLUIR_EN_BALANCE] = true),
    Orden   = Table.Sort(Incluir, {{"ID_EQUIPO", Order.Ascending},{"FECHA_LECTURA", Order.Ascending}}),

    Grupos  = Table.Group(Orden, {"ID_EQUIPO"}, {{"t", each
                let t0 = Table.Sort(_, {{"FECHA_LECTURA", Order.Ascending}}),
                    f  = Table.Column(t0, "FECHA_LECTURA"),
                    pv = {null} & List.RemoveLastN(f, 1)
                in  Table.FromColumns(Table.ToColumns(t0) & {pv}, Table.ColumnNames(t0) & {"Fecha_Previa"}),
              type table}}),
    Plano   = Table.ExpandTableColumn(Grupos, "t",
                List.Difference(Table.ColumnNames(Grupos{0}[t]), {"ID_EQUIPO"})),

    Dias    = Table.AddColumn(Plano, "Dias_Periodo", each
                if [Fecha_Previa] = null then null
                else List.Max({Duration.Days([FECHA_LECTURA] - [Fecha_Previa]), 1}), Int64.Type),
    Filtra  = Table.SelectRows(Dias, each [Dias_Periodo] <> null and [M3_Final] <> null and [M3_Final] > 0),
    M3Dia   = Table.AddColumn(Filtra, "M3_Dia", each [M3_Final] / [Dias_Periodo], type number),
    ListaF  = Table.AddColumn(M3Dia, "Fecha", each
                List.Dates(Date.AddDays([Fecha_Previa],1), [Dias_Periodo], #duration(1,0,0,0)), type list),
    Expande = Table.ExpandListColumn(ListaF, "Fecha"),
    Tipos   = Table.TransformColumnTypes(Expande, {{"Fecha", type date}})
in
    Table.SelectColumns(Tipos, {"ID_EQUIPO","Fecha","M3_Dia","FECHA_LECTURA","Dias_Periodo","M3_Final"})
```

**Cómo leerlo:** si CONT07 marcó 1,950 m³ entre el 15/06 y el 19/06, el modelo carga 487.5 m³ el 16, 17, 18 y 19. Con eso la comparación semanal contra el riego es válida.

**`ConsumoGoteroDia`** — promedia naves (clic derecho → **desmarcar "Habilitar carga"**, es auxiliar)
```m
let
    Origen  = Table.SelectRows(CONSUMOAGUAINVERNADEROS, each [ML_Valido] = true),
    PorNave = Table.Group(Origen, {"Invernadero","Nave","Fecha de colecta de muestra"},
                {{"ML", each List.Average([#"Volumen de gotero"]), type number},
                 {"DRE", each List.Average([#"Volumen drenaje"]), type number}}),
    PorInv  = Table.Group(PorNave, {"Invernadero","Fecha de colecta de muestra"},
                {{"ML_Planta_Dia",  each List.Average([ML]), type number},
                 {"ML_Drenaje_Dia", each List.Average([DRE]), type number},
                 {"Naves_Medidas",  each Table.RowCount(_), Int64.Type}}),
    Marca   = Table.AddColumn(PorInv, "Fecha_Medicion", each [#"Fecha de colecta de muestra"], type date)
in
    Table.RenameColumns(Marca, {{"Fecha de colecta de muestra","Fecha"}})
```

> **Aquí va el promedio, no la suma.** El `Volumen de gotero` ya es mL **por planta**, y se muestrea una nave a la vez. Como las plantas están por invernadero y no por nave, la fórmula correcta es `Plantas_GH × promedio(mL) ÷ 1000`. Si sumas las naves, multiplicas el consumo por el número de naves. Un atajo para verificarlo de memoria: el valor en mL es directamente **los litros/día por cada 1,000 plantas**.

**`fRiegoDia`** — la tabla de hechos del Análisis 2
```m
let
    // 1) un renglón por set y por día del ciclo
    Origen = PLANTAS,
    ListaF = Table.AddColumn(Origen, "Fecha", each
                List.Dates([Fecha_Inicio], Duration.Days([Fecha_Fin]-[Fecha_Inicio])+1, #duration(1,0,0,0)), type list),
    Exp    = Table.ExpandListColumn(ListaF, "Fecha"),
    Tipo   = Table.TransformColumnTypes(Exp, {{"Fecha", type date}}),
    DDT    = Table.AddColumn(Tipo, "DDT", each Duration.Days([Fecha]-[Fecha_Inicio]), Int64.Type),

    // 2) etapa fenológica
    Etapa  = Table.AddColumn(DDT, "Etapa", each
                if [DDT] < [DDT_IniPol] then "Vegetativa"
                else if [DDT] < [DDT_FinPol] then "Polinizacion"
                else if [DDT] < [DDT_IniCos] then "Llenado de fruto"
                else if [DDT] <= [DDT_FinCos] then "Cosecha" else "Post-cosecha", type text),

    // 3) mL medido del invernadero ese día
    ConML  = Table.ExpandTableColumn(
                Table.NestedJoin(Etapa, {"Greenhouse","Fecha"}, ConsumoGoteroDia, {"Invernadero","Fecha"}, "m", JoinKind.LeftOuter),
                "m", {"ML_Planta_Dia","ML_Drenaje_Dia","Naves_Medidas","Fecha_Medicion"}),

    // 4) relleno hacia adelante, máximo pDiasMaxRelleno días
    Orden  = Table.Sort(ConML, {{"Greenhouse", Order.Ascending},{"Fecha", Order.Ascending}}),
    Grupo  = Table.Group(Orden, {"Greenhouse"}, {{"t", each
                Table.FillDown(Table.Sort(_, {{"Fecha", Order.Ascending}}),
                    {"ML_Planta_Dia","ML_Drenaje_Dia","Fecha_Medicion"}), type table}}),
    Plano  = Table.ExpandTableColumn(Grupo, "t", List.Difference(Table.ColumnNames(Grupo{0}[t]), {"Greenhouse"})),
    Antig  = Table.AddColumn(Plano, "Dias_Desde_Medicion",
                each if [Fecha_Medicion]=null then null else Duration.Days([Fecha]-[Fecha_Medicion]), Int64.Type),
    MLUso  = Table.AddColumn(Antig, "ML_Usado", each
                if [ML_Planta_Dia]=null then null
                else if [Dias_Desde_Medicion] > pDiasMaxRelleno then null
                else [ML_Planta_Dia], type number),
    Estado = Table.AddColumn(MLUso, "Estado_Dato", each
                if [Dias_Desde_Medicion]=0 then "Medido"
                else if [ML_Usado]<>null then "Estimado" else "Sin dato", type text),

    // 5) litros por set — reparto exacto, porque el mL es por planta
    Litros = Table.AddColumn(Estado, "Litros_Dia", each
                if [ML_Usado]=null then null else [ML_Usado]*[PlantsTransplanted]/1000, type number),
    M3     = Table.AddColumn(Litros, "M3_Dia", each if [Litros_Dia]=null then null else [Litros_Dia]/1000, type number),
    Dren   = Table.AddColumn(M3, "Litros_Drenaje_Dia", each
                if [ML_Drenaje_Dia]=null then null else [ML_Drenaje_Dia]*[PlantsTransplanted]/1000, type number)
in
    Table.SelectColumns(Dren, {"Fecha","Greenhouse","SetName","Crop","Program","PlantsTransplanted","DDT","Etapa",
      "ML_Usado","Estado_Dato","Dias_Desde_Medicion","Naves_Medidas","Litros_Dia","M3_Dia","Litros_Drenaje_Dia",
      "Origen_Fechas","Estado_Set"})
```

