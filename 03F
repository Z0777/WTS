## 6.3 `PLANTAS`

```m
let
    Origen = SharePoint.Tables(pSitio, [Implementation="2.0", ViewMode="All"]),
    Lista  = Origen{[Title="PLANTAS"]}[Items],
    Cols   = Table.SelectColumns(Lista, {"Crop","Program","Greenhouse","PlantsTransplanted",
             "Expected transplanting date","Real  transplanting date","Real last harvest date",
             "Expected Last harvest date","SetName"}),

    Limpio = Table.TransformColumns(Cols, {
                {"Greenhouse",         each fnNormalizaInv(_), type text},
                {"Crop",               each Text.Trim(Text.From(_)), type text},
                {"PlantsTransplanted", each fnTextoANumero(_), type number}}),

    FIni   = Table.AddColumn(Limpio, "Fecha_Inicio", each
                let r = fnFechaSP([#"Real  transplanting date"]),
                    e = fnFechaSP([#"Expected transplanting date"])
                in if r <> null then r else e, type date),
    FinReg = Table.AddColumn(FIni, "Fin_Registrado", each
                let r = fnFechaSP([#"Real last harvest date"]),
                    e = fnFechaSP([#"Expected Last harvest date"])
                in if r <> null then r else e, type date),

    ConCic = Table.ExpandTableColumn(
                Table.NestedJoin(FinReg, {"Crop"}, dCultivo, {"Crop"}, "c", JoinKind.LeftOuter),
                "c", {"DiasEnInvernadero","DDT_IniPol","DDT_FinPol","DDT_IniCos","DDT_FinCos"}),

    FFin   = Table.AddColumn(ConCic, "Fecha_Fin", each
                if [Fin_Registrado] <> null then [Fin_Registrado]
                else if [Fecha_Inicio] <> null and [DiasEnInvernadero] <> null
                     then Date.AddDays([Fecha_Inicio], [DiasEnInvernadero]) else null, type date),

    Orig   = Table.AddColumn(FFin, "Origen_Fechas", each
                (if fnFechaSP([#"Real  transplanting date"]) <> null then "Trasplante real" else "Trasplante estimado")
                & " / " &
                (if fnFechaSP([#"Real last harvest date"]) <> null then "Cosecha real" else "Cosecha estimada"), type text),

    Estado = Table.AddColumn(Orig, "Estado_Set", each
                if [Fecha_Inicio] = null then "Sin fecha"
                else if [Fecha_Inicio] > Date.From(DateTime.LocalNow()) then "Programado"
                else if [Fecha_Fin] <> null and [Fecha_Fin] < Date.From(DateTime.LocalNow()) then "Finalizado"
                else "Activo", type text),

    Final  = Table.SelectRows(Estado, each
                [Fecha_Inicio] <> null and [Fecha_Fin] <> null and [Fecha_Fin] >= [Fecha_Inicio]
                and [PlantsTransplanted] <> null and [PlantsTransplanted] > 0
                and [Greenhouse] <> null and [Crop] <> null)
in
    Final
```

