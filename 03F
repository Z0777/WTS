                else if [DDT] < [DDT_FinPol] then "Polinizacion"
                else if [DDT] < [DDT_IniCos] then "Llenado de fruto"
                else if [DDT] <= [DDT_FinCos] then "Cosecha"
                else "Post-cosecha", type text),

    // 3) mL medido del invernadero ese dia
    ConML  = Table.ExpandTableColumn(
                Table.NestedJoin(Etapa, {"Greenhouse","Fecha"}, ConsumoGoteroDia, {"Invernadero","Fecha"},
                                 "m", JoinKind.LeftOuter),
                "m", {"ML_Planta_Dia","ML_Drenaje_Dia","Naves_Medidas"}),

    // 4) columnas auxiliares para interpolar
    A1     = Table.AddColumn(ConML, "MLAnt",  each [ML_Planta_Dia], type number),
    A2     = Table.AddColumn(A1,    "FecAnt", each if [ML_Planta_Dia] = null then null else [Fecha], type date),
    A3     = Table.AddColumn(A2,    "MLSig",  each [ML_Planta_Dia], type number),
    A4     = Table.AddColumn(A3,    "FecSig", each if [ML_Planta_Dia] = null then null else [Fecha], type date),

    Reduce = Table.SelectColumns(A4, {"Fecha","Greenhouse","SetName","Crop","Program","PlantsTransplanted",
                "DDT","Etapa","ML_Planta_Dia","ML_Drenaje_Dia","Naves_Medidas","Origen_Fechas","Estado_Set",
                "MLAnt","FecAnt","MLSig","FecSig"}),

    // 5) rellenar hacia atras y hacia adelante DENTRO de cada invernadero
    Grupo  = Table.Group(Reduce, {"Greenhouse"}, {{"t", each
                Table.FillUp(
                    Table.FillDown(Table.Sort(_, {{"Fecha", Order.Ascending}}), {"MLAnt","FecAnt"}),
                    {"MLSig","FecSig"}), type table}}),
    Plano  = Table.ExpandTableColumn(Grupo, "t",
                {"Fecha","SetName","Crop","Program","PlantsTransplanted","DDT","Etapa","ML_Planta_Dia",
                 "ML_Drenaje_Dia","Naves_Medidas","Origen_Fechas","Estado_Set",
                 "MLAnt","FecAnt","MLSig","FecSig"}),

    // 6) interpolacion lineal: todos los dias del ciclo quedan con valor
    MLUso  = Table.AddColumn(Plano, "ML_Usado", each
                if [ML_Planta_Dia] <> null then [ML_Planta_Dia]
                else if [MLAnt] <> null and [MLSig] <> null and [FecSig] <> [FecAnt] then
                    [MLAnt] + ([MLSig] - [MLAnt])
                            * Duration.Days([Fecha] - [FecAnt]) / Duration.Days([FecSig] - [FecAnt])
                else if [MLAnt] <> null then [MLAnt]
                else if [MLSig] <> null then [MLSig]
                else null, type number),

    Estado = Table.AddColumn(MLUso, "Estado_Dato", each
                if [ML_Planta_Dia] <> null then "Medido"
                else if [MLAnt] <> null and [MLSig] <> null then "Interpolado"
                else if [ML_Usado] <> null then "Extendido"
                else "Sin medicion en el ciclo", type text),

    // 7) litros por set — el mL es por planta, asi que el reparto es exacto
    Litros = Table.AddColumn(Estado, "Litros_Dia", each
                if [ML_Usado] = null then 0 else [ML_Usado] * [PlantsTransplanted] / 1000, type number),
    M3     = Table.AddColumn(Litros, "M3_Dia", each [Litros_Dia] / 1000, type number),
    Dren   = Table.AddColumn(M3, "Litros_Drenaje_Dia", each
                if [ML_Drenaje_Dia] = null then 0
                else [ML_Drenaje_Dia] * [PlantsTransplanted] / 1000, type number),

    Final  = Table.SelectColumns(Dren, {"Fecha","Greenhouse","SetName","Crop","Program",
                "PlantsTransplanted","DDT","Etapa","ML_Usado","Estado_Dato","Naves_Medidas",
                "Litros_Dia","M3_Dia","Litros_Drenaje_Dia","Origen_Fechas","Estado_Set"})
in
    Final
```

Ahora **Inicio → Cerrar y aplicar**.

