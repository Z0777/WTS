ClearCollect(
    colTmp;
    ForAll(
        colPeriodos As P;
        {
            Sub: ForAll(
                Sequence(P.Dias) As S;
                {
                    Equipo:      P.Equipo;
                    Fecha:       DateAdd(P.FechaIni; S.Value; TimeUnit.Days);
                    M3Dia:       P.M3Dia;
                    HorasDia:    P.HorasDia;
                    CostoDia:    P.CostoDia;
                    EsLectura:   S.Value = P.Dias;
                    DiasPeriodo: P.Dias
                }
            )
        }
    )
);;
ClearCollect(colDiasBase; Ungroup(colTmp; "Sub"));;

// ══════════════ 6. CLASIFICACION Y LLAVES DE TIEMPO ══════════════
ClearCollect(
    colDias;
    ForAll(
        colDiasBase As D;
        With(
            { _g: LookUp(colGrupos; Equipo = D.Equipo) };
            {
                Equipo:      D.Equipo;
                Fecha:       D.Fecha;
                Anio:        Year(D.Fecha);
                NumMes:      Month(D.Fecha);
                IniMes:      Date(Year(D.Fecha); Month(D.Fecha); 1);
                IniSemana:   DateAdd(D.Fecha; -(Weekday(D.Fecha; StartOfWeek.Monday) - 1); TimeUnit.Days);
                M3Dia:       D.M3Dia;
                HorasDia:    D.HorasDia;
                CostoDia:    D.CostoDia;
                EsLectura:   D.EsLectura;
                DiasPeriodo: D.DiasPeriodo;
                Grupo:       Coalesce(_g.Grupo; "Otros");
                Sistema:     Coalesce(_g.Sistema; "Sin sistema");
                Etiqueta:    Coalesce(_g.Etiqueta; D.Equipo);
                ColorHex:    Coalesce(_g.ColorHex; "#94A3B8");
                Orden:       Coalesce(_g.Orden; 99)
            }
        )
    )
);;
Clear(colTmp);;
Clear(colDiasBase);;
Clear(colPeriodos);;

// ══════════════ 7. ESTADO INICIAL DEL ANALISIS ══════════════
Set(varMinFecha; First(Sort(colDias; Fecha; SortOrder.Ascending)).Fecha);;
Set(varMaxFecha; First(Sort(colDias; Fecha; SortOrder.Descending)).Fecha);;
Set(varAnaAnio; Year(Coalesce(varMaxFecha; Today())));;
Set(varMesSel; 0);;
Set(varAnaIni; Date(varAnaAnio; 1; 1));;
Set(varAnaFin; Date(varAnaAnio; 12; 31));;
Set(varGranularidad; "Mes")
```

> **Importante:** este bloque completo va también en el `OnSelect` del ícono `icnAnaActualizar`, y al final del `OnSelect` de `Button3` (guardar lectura), para que lo nuevo se vea sin recargar. Si no quieres repetirlo, deja `Set(varRecalcular; !varRecalcular)` en esos dos y pon el bloque en el `OnChange` de un `Toggle` oculto cuyo `Default` sea `varRecalcular`.

