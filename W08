## PARTE 2 · `App.Formulas` completo

Pega esto entero. Cada fórmula termina en `;`.

```powerfx
// ─────────── base filtrada por el rango activo ───────────
frDias = Filter(colDias; Fecha >= varAnaIni; Fecha <= varAnaFin);

// ─────────── tamaño del rango ───────────
frNumDias    = Max(DateDiff(varAnaIni; varAnaFin; TimeUnit.Days) + 1; 1);
frNumSemanas = frNumDias / 7;
frNumMeses   = frNumDias * 10 / 304;
frNumHoras   = frNumDias * 24;

// ─────────── totales por grupo ───────────
frBombeada    = Sum(Filter(frDias; Grupo = "Bombeada"); M3Dia);
frClarificada = Sum(Filter(frDias; Grupo = "Clarificada"); M3Dia);
frConsumida   = Sum(Filter(frDias; Grupo = "Consumida"); M3Dia);
frOtros       = Sum(Filter(frDias; Grupo = "Otros"); M3Dia);
frLecturas    = CountRows(Filter(frDias; EsLectura));

// ─────────── lo que hace dinámica la granularidad ───────────
frDivisor =
Switch(
    varGranularidad;
    "Dia";    frNumDias;
    "Semana"; frNumSemanas;
    "Hora";   frNumHoras;
    frNumMeses
);

frTextoGran =
Switch(
    varGranularidad;
    "Dia";    "por día";
    "Semana"; "por semana";
    "Hora";   "por hora";
    "por mes"
);

frTituloGran =
Switch(
    varGranularidad;
    "Dia";    "PROM. DÍA";
    "Semana"; "PROM. SEMANA";
    "Hora";   "PROM. HORA";
    "PROM. MES"
);

frFormatoGran = If(varGranularidad = "Hora"; "#.##0,000"; "#.##0,00");

frEncPeriodo =
Switch(
    varGranularidad;
    "Dia";    "DÍA";
    "Semana"; "SEMANA";
    "MES"
);

// ─────────── claves del período según granularidad ───────────
frClaves =
Switch(
    varGranularidad;
    "Dia";    Sort(Distinct(frDias; Fecha); Value; SortOrder.Ascending);
    "Semana"; Sort(Distinct(frDias; IniSemana); Value; SortOrder.Ascending);
    Sort(Distinct(frDias; IniMes); Value; SortOrder.Ascending)
);

// ═══════════ TABLA 1 — un renglón por período ═══════════
frTabla =
ForAll(
    Sequence(CountRows(frClaves)) As I;
    With(
        { _k: Last(FirstN(frClaves; I.Value)).Value };
        With(
            {
                _sub: Switch(
                    varGranularidad;
                    "Dia";    Filter(frDias; Fecha = _k);
                    "Semana"; Filter(frDias; IniSemana = _k);
                    Filter(frDias; IniMes = _k)
                )
            };
            With(
                {
                    _b: Sum(Filter(_sub; Grupo = "Bombeada"); M3Dia);
                    _c: Sum(Filter(_sub; Grupo = "Clarificada"); M3Dia);
                    _s: Sum(Filter(_sub; Grupo = "Consumida"); M3Dia)
                };
                {
                    Indice: I.Value;
                    Clave:  _k;
                    Etiqueta: Switch(
                        varGranularidad;
                        "Dia";    Text(_k; "dd/mm/yyyy"; "es-ES");
                        "Semana"; "Sem " & Text(_k; "dd/mm"; "es-ES");
                        Text(_k; "mmmm yyyy"; "es-ES")
                    );
                    Bombeada:    _b;
                    Clarificada: _c;
                    Consumida:   _s;
                    Balance:     _b - _s;
                    PorcCons:    If(_b > 0; _s / _b; 0);
                    Lecturas:    CountRows(Filter(_sub; EsLectura))
                }
            )
        )
    )
);

// ═══════════ TABLA 2 — un renglón por contador ═══════════
frTablaEquipo =
ForAll(
    Sequence(CountRows(Filter(colGrupos; Grupo <> "Excluir"))) As I;
    With(
        { _g: Last(FirstN(Sort(Filter(colGrupos; Grupo <> "Excluir"); Orden; SortOrder.Ascending); I.Value)) };
        With(
            { _sub: Filter(frDias; Equipo = _g.Equipo) };
            With(
                {
                    _t: Sum(_sub; M3Dia);
                    _grp: Switch(
                        _g.Grupo;
                        "Bombeada";    frBombeada;
                        "Clarificada"; frClarificada;
                        "Consumida";   frConsumida;
                        frOtros
                    )
                };
                {
                    Indice:    I.Value;
                    Sistema:   _g.Sistema;
                    Contador:  _g.Equipo;
                    Nombre:    _g.Etiqueta;
                    Tipo:      _g.Grupo;
                    ColorHex:  _g.ColorHex;
                    Total:     _t;
                    Promedio:  _t / frDivisor;
                    PorcGrupo: If(_grp > 0; _t / _grp; 0);
                    Lecturas:  CountRows(Filter(_sub; EsLectura));
                    DiasDato:  CountRows(Distinct(_sub; Fecha))
                }
            )
        )
    )
);
```

> **Por qué `Sequence` + `Last(FirstN(...))` en vez de `ForAll(tabla As X)`:** así cada renglón trae su número de fila en `Indice`, que es lo que necesitas para pintar las filas alternadas. Es el equivalente de un índice de fila, que Power Apps no da de otra forma.

