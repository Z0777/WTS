### 4.4 Gráficos circulares con porcentaje

El gráfico circular clásico **no muestra el porcentaje**. La forma de tenerlo es meterlo en la etiqueta:

```powerfx
// pieAnaBombeo.Items
With(
    { _tot: frBombeada };
    ForAll(
        Sort(Filter(colGrupos; Grupo = "Bombeada"); Orden; SortOrder.Ascending) As G;
        With(
            { _v: Sum(Filter(frDias; Equipo = G.Equipo); M3Dia) };
            {
                Fuente: G.Etiqueta & "  " & Text(If(_tot > 0; _v / _tot; 0); "0,0%"; "es-ES");
                M3: _v
            }
        )
    )
)
```

```powerfx
// pieAnaClarificada.Items
With(
    { _tot: frClarificada };
    ForAll(
        Sort(Filter(colGrupos; Grupo = "Clarificada"); Orden; SortOrder.Ascending) As G;
        With(
            { _v: Sum(Filter(frDias; Equipo = G.Equipo); M3Dia) };
            {
                Clarificador: G.Etiqueta & "  " & Text(If(_tot > 0; _v / _tot; 0); "0,0%"; "es-ES");
                M3: _v
            }
        )
    )
)
```

```powerfx
// pieAnaConsumo.Items
With(
    { _tot: frConsumida };
    ForAll(
        Sort(Filter(colGrupos; Grupo = "Consumida"); Orden; SortOrder.Ascending) As G;
        With(
            { _v: Sum(Filter(frDias; Equipo = G.Equipo); M3Dia) };
